# ─────────────────────────────────────────────────────────────
# TradeMonk AI — environment variables (placeholders only)
# Copy to .env.local and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── Public (safe for the browser) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Server only (never import into client code) ──
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# REQUIRED. Exactly one of: development | staging | production. There is NO default: if it is
# unset, empty or misspelled the server refuses to build its configuration (nothing is silently
# treated as development).
#   development -> LOCAL machines only: allows MOCK DATA, and rate limiting fails open if the
#                  rate_limits RPC is unreachable. Rejected on a deployed Vercel environment.
#   staging / production -> real providers only, rate limiting fails CLOSED, mock providers rejected.
# Set it explicitly in every Vercel environment scope you deploy (Production AND Preview).
# Do not set VERCEL_ENV yourself: Vercel provides it and the app uses it as a safety cross-check.
APP_ENV=development

# ── Market data (Phase 2) ──
# binance | mock. "mock" is accepted ONLY when APP_ENV=development (any other value is a configuration error)
# and is labelled MOCK DATA in the UI.
CRYPTO_PROVIDER=binance
# Optional override. Default is Binance's public market-data-only host.
# BINANCE_BASE_URL=https://data-api.binance.vision
# none | mock. "none" => Indian instruments show "Data unavailable" until a licensed vendor adapter is added.
# "mock" is accepted ONLY when APP_ENV=development.
INDIAN_MARKET_PROVIDER=none
# Vendor credentials (added when an Indian vendor is chosen): server-only, never NEXT_PUBLIC_.

# ── Scheduled jobs (Phase 5B) ──
# Shared secret for /api/cron/* routes. Generate with: openssl rand -hex 32
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". While unset, cron routes refuse to run.
CRON_SECRET=

# ── Staging smoke test (Phase 5C-7B, opt-in; see docs/staging-smoke-test.md) ──
# Used ONLY by `pnpm smoke:staging`. Put real values in .env.staging.local (git-ignored) or your shell/secret
# manager, never here. For that script APP_ENV must be exactly "staging" and NEXT_PUBLIC_SUPABASE_URL must be the
# STAGING project. Both refs are declared so the script can prove the target is not production.
# STAGING_SUPABASE_PROJECT_REF=your-staging-project-ref
# PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref
# Optional: domain for disposable test-user emails (default example.com; email_confirm is set, no mail is sent).
# SMOKE_TEST_EMAIL_DOMAIN=example.com

# ── Added in later phases ──
# Phase 6: AI_PROVIDER=  AI_BASE_URL=  AI_API_KEY=  AI_MODEL=
# Phase 7: TELEGRAM_BOT_TOKEN=  RESEND_API_KEY=
# Phase 8: RAZORPAY_KEY_ID=  RAZORPAY_KEY_SECRET=  STRIPE_SECRET_KEY=
